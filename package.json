{
  "name": "smart-study-app",
  "version": "1.0.0",
  "description": "Smart study web application for students.",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/build-vendor.js",
    "vendor:build": "node scripts/build-vendor.js",
    "pretest": "npm run vendor:build",
    "start": "node server.js",
    "dev": "concurrently \"node --watch server.js\" \"npm run tailwind:watch\"",
    "init-db": "node ./backend/models/db.js init",
    "test": "node --test ./backend/tests/studyContent.test.js ./backend/tests/admin.test.js ./backend/tests/aiRequests.test.js ./backend/tests/environment.test.js ./backend/tests/security.test.js ./backend/tests/followup.test.js ./backend/tests/localCompatibility.test.js",
    "test:oracle": "node --test ./backend/tests/oracle.test.js",
    "test:ui": "playwright test",
    "tailwind:build": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
    "tailwind:build:production": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "tailwind:watch": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch"
  },
  "keywords": [
    "study",
    "ocr",
    "ai",
    "summary",
    "flashcards",
    "quiz"
  ],
  "author": "AI Developer",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.15.8",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.6.7",
    "nodemailer": "^10.1.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^8.2.2",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^5.1.1"
  },
  "type": "commonjs",
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "@parcel/watcher": "^2.6.0",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  }
}
