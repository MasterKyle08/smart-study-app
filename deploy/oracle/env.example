# The private .env.oracle in the project root already has your existing app keys.
# Upload it as .env on the server after filling in SMTP_PASS; never commit it.
SITE_ADDRESS=study.132-145-197-174.sslip.io
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1

TURSO_DATABASE_URL=libsql://YOUR_EXISTING_DATABASE.turso.io
TURSO_AUTH_TOKEN=
JWT_SECRET=
GOOGLE_API_KEY=
# Keep your existing working model name.
GOOGLE_AI_MODEL_NAME=gemma-4-31b-it
# During provider outages, use the other free Gemma 4 model for five minutes.
# Use 'none' to disable fallback. These are optional; code defaults match below.
GOOGLE_FREE_FALLBACK_MODEL=gemma-4-26b-a4b-it
GOOGLE_FREE_REQUEST_INTERVAL_MS=4000
GOOGLE_FREE_PRIMARY_TIMEOUT_MS=25000
GOOGLE_FREE_FALLBACK_COOLDOWN_MS=300000
ADMIN_EMAIL=kmounties@outlook.com
ADMIN_NOTIFY_EMAIL=kmounties@outlook.com

# Optional premium: keep the existing values if already configured.
GOOGLE_PREMIUM_API_KEY=
GOOGLE_PREMIUM_MODEL_NAME=gemini-3.5-flash-lite
PREMIUM_USER_EMAILS=
PREMIUM_MONTHLY_PRICE=6

# Required for email-based admin verification in production.
# Gmail sends codes to your Outlook owner account. Use a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=kmounties@gmail.com
SMTP_PASS=
SMTP_FROM=kmounties@gmail.com

# Alternatively, use Resend with a sender domain you have verified.
RESEND_API_KEY=
EMAIL_FROM=

# Despite its name, the existing app reads RATE_LIMIT_WINDOW_MS as minutes.
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
ANONYMOUS_SESSION_TTL_HOURS=24

# Keep cloud monitoring off unless using inline service-account JSON.
# A Windows path in GOOGLE_APPLICATION_CREDENTIALS won't exist in a container.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=

# If Stripe is enabled, use absolute HTTPS redirect URLs for the new hostname.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://study.132-145-197-174.sslip.io/dashboard.html?billing=success
BILLING_CANCEL_URL=https://study.132-145-197-174.sslip.io/dashboard.html?billing=cancel
