NODE_ENV=development
PORT=3000

# Free Gemma project (AI Studio project A)
GOOGLE_API_KEY=
GOOGLE_FREE_API_KEY=
GOOGLE_AI_MODEL_NAME=gemma-4-31b-it

# Paid Gemini project (AI Studio project B) — separate key
GOOGLE_PREMIUM_API_KEY=
GOOGLE_PREMIUM_MODEL_NAME=gemini-3.5-flash-lite
PREMIUM_USER_EMAILS=

JWT_SECRET=change-me-to-a-long-random-string

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100
ANONYMOUS_SESSION_TTL_HOURS=24

GEMMA_DAILY_BUDGET=1500
FREE_DAILY_JOBS=24
ANON_DAILY_JOBS=10
PREMIUM_DAILY_JOBS=200
AD_REWARDS_PER_DAY=2
AD_COOLDOWN_HOURS=4
JOBS_PER_AD=1
USAGE_ALLOW_DEV_ADS=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_VARIANT_ID=
PREMIUM_MONTHLY_PRICE=5
PREMIUM_PRICE_LABEL=$5 / month

ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
ADSENSE_VIEW_SECONDS=15

# Admin: owner email is always admin and cannot be demoted/deleted/banned.
ADMIN_EMAIL=
ADMIN_NOTIFY_EMAIL=
ADMIN_OWNER_EMAILS=
ADMIN_SESSION_MINUTES=20

# SMS 2FA (Twilio). Required in production for admin unlock if you want texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email fallback for 2FA + admin permission-change alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=

# Optional live Gemini/Gemma request counts via Cloud Monitoring (server-side only).
# Metric: serviceruntime.googleapis.com/api/request_count on generativelanguage.googleapis.com
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCP_MONITORING_CACHE_SECONDS=90
